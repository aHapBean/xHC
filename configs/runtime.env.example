# Copy to configs/runtime.env and fill the TODO values before training.
# Existing exported variables take precedence, including scheduler-provided values.
# DATA_ARGS: path to a JSON mixture of Megatron indexed dataset prefixes.
# TOKENIZER_DIR: local tokenizer directory matching the indexed data.
export DATA_ARGS="${DATA_ARGS:-}"          # TODO: absolute path to your mixture JSON
export TOKENIZER_DIR="${TOKENIZER_DIR:-}"  # TODO: absolute path to your tokenizer directory

# Optional paths. Empty values use <repository>/experiments and its data_cache.
# Set these before sourcing this file, or replace the empty defaults below.
export EXPERIMENTS_ROOT="${EXPERIMENTS_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/experiments}"
export DATA_CACHE="${DATA_CACHE:-${EXPERIMENTS_ROOT}/data_cache}"

# Single-node defaults. For multiple nodes, set NNODES and a unique NODE_RANK
# on each node, plus a shared reachable MASTER_ADDR and MASTER_PORT.
export NNODES="${NNODES:-1}"
export GPUS="${GPUS:-4}"                    # GPUs per node, not total GPUs
export NODE_RANK="${NODE_RANK:-0}"
export MASTER_ADDR="${MASTER_ADDR:-}"      # TODO for multi-node: node 0 address
export MASTER_PORT="${MASTER_PORT:-29500}"
export PYTHON_BIN="${PYTHON_BIN:-python3}"

# Optional overrides. Otherwise the chosen YAML supplies MBS, EP and dispatcher.
# export MBS=3
# export EP=4
# export MOE_DISPATCHER=hybridep             # Requires installed HybridEP dependencies
# export NCCL_SOCKET_IFNAME=TODO
# export GLOO_SOCKET_IFNAME=TODO
# Set EXP_NAME per launch; avoid sharing output directories between live jobs.
